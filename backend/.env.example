NODE_ENV=development
HOST=127.0.0.1
PORT=4002
PUBLIC_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DATABASE_URL is optional. Individual DB_* values take precedence.
# DATABASE_URL=mysql://username:password@127.0.0.1:3306/sube_analitik_cirox
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=sube_analitik_cirox
DB_LOGGING=false
# Tables will be added through migrations in the next stage.
DB_SYNCHRONIZE=false

SESSION_TTL_DAYS=7
SEED_ADMIN_EMAIL=admin@subeanalitik.com
# Set a unique password of at least 12 characters before running seed:admin.
SEED_ADMIN_PASSWORD=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Base64 of 32 random bytes; keep this key backed up and identical on the VPS.
R2_RECEIPT_ENCRYPTION_KEY=

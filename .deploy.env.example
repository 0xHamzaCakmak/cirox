# Sunucuda .deploy.env olarak kopyalayin. Bu dosya Bash sozdizimi kullanir.
# DB, R2 ve admin bilgileri burada degil backend/.env dosyasinda tutulur.
BRANCH="${BRANCH:-main}"
WEB_ROOT="${WEB_ROOT:-/var/www/cirox}"
BACKEND_PORT="${BACKEND_PORT:-4002}"
RELOAD_NGINX="${RELOAD_NGINX:-true}"
# Yalnizca ilk kurulumda, DB henuz yoksa true yapin. CREATE yetkisi gerekir.
INIT_DATABASE="${INIT_DATABASE:-false}"
# Basarili deploy sonrasinda son 3 backend surumu saklanir.
KEEP_RELEASES="${KEEP_RELEASES:-3}"
# Basarili deploy sonrasinda son 7 sikistirilmis DB yedegi saklanir.
KEEP_BACKUPS="${KEEP_BACKUPS:-7}"

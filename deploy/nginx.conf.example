# Ilk kurulum ornegi. server_name ve root degerlerini kendi sunucunuza uyarlayin.
# HTTPS sertifikasini (or. Certbot) kurduktan sonra PUBLIC_FRONTEND_ORIGINS'i
# gercek https:// alan adina ayarlayin. Mobil canli kamera HTTPS gerektirir.
server {
    listen 80;
    server_name cirox.example.com;
    root /var/www/cirox;
    index index.html;
    client_max_body_size 24m;

    # .env, .deploy ve gizli dosyalar hicbir zaman sunulmaz.
    location ~ /\. { deny all; }

    location /api/ {
        proxy_pass http://127.0.0.1:4002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 90s;
        # API'nin oturum ve ozel fotograf cache basliklari korunur.
        proxy_cache off;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location = /sw.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }
    location = /registerSW.js {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
